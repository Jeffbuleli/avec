# Copy to ops/vps/.env (never commit).
# JWT_SECRET and Postgres MUST match McBuleli — same users + same group tables.

POSTGRES_USER=mcbuleli
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mcbuleli

NEXT_PUBLIC_APP_URL=https://e-avec.org
NEXT_PUBLIC_MCBULELI_ORIGIN=https://mcbuleli.org
DATABASE_URL=postgresql://mcbuleli:change-me-strong-password@db:5432/mcbuleli

# Same value as McBuleli so existing passwords keep working.
JWT_SECRET=

# Governance tick stays on McBuleli crontab. Leave unset here unless you
# disable it on McBuleli first (do not run two ticks).
CRON_SECRET=

# Required for login (copy from McBuleli .env — install-eavec.sh syncs these).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Passkeys / FIDO (WebAuthn)
# To allow passkeys registered on `mcbuleli.org` to authenticate on `e-avec.org`,
# set a shared RP ID (recommended: `org`). Note: existing passkeys may need re-registration.
# WEBAUTHN_RP_ID=org
# WEBAUTHN_ORIGIN=https://e-avec.org

# Optional: Didit KYC — same workflow as McBuleli (install-eavec.sh can sync).
# KYC_ENABLED=true

# e-AVEC emails (Resend) — independent from McBuleli noreply.
RESEND_E_AVEC=
AUTH_EMAIL_FROM=e-AVEC <noreply@e-avec.org>
AUTH_EMAIL_REPLY_TO=support@e-avec.org

# Mobile Money (PawaPay DRC) — same credentials as McBuleli VPS.
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=production
# PAWAPAY_CALLBACK_SECRET=
